<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_FESTIVEOVERLAY</name>
    <author>Mark Buckwell</author>
    <creationDate>2026-11</creationDate>
    <copyright>Copyright (C) 2026 Mark Buckwell</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>0.1.0-beta4</version>
    <description>PLG_SYSTEM_FESTIVEOVERLAY_XML_DESCRIPTION</description>
    <namespace path="src">FestiveOverlay\Plugin\System\FestiveOverlay</namespace>
    <files>
        <folder plugin="festiveoverlay">services</folder>
        <folder>src</folder>
        <filename>LICENSE.txt</filename>
        <filename>THIRD_PARTY_NOTICES.txt</filename>
    </files>
    <media destination="plg_system_festiveoverlay" folder="media">
        <folder>css</folder>
        <folder>js</folder>
        <folder>images</folder>
    </media>
    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_festiveoverlay.ini</language>
        <language tag="en-GB">en-GB/plg_system_festiveoverlay.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="enabled" type="radio" layout="joomla.form.field.radio.switcher"
                    default="0" filter="integer"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_FIELD_ENABLED_LABEL"
                    description="PLG_SYSTEM_FESTIVEOVERLAY_FIELD_ENABLED_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="effect" type="list" default="auto" filter="cmd"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_EFFECT_LABEL" description="PLG_SYSTEM_FESTIVEOVERLAY_EFFECT_DESC">
                    <option value="auto">PLG_SYSTEM_FESTIVEOVERLAY_EFFECT_AUTO</option>
                    <option value="snow">PLG_SYSTEM_FESTIVEOVERLAY_EFFECT_SNOW</option>
                    <option value="fireworks">PLG_SYSTEM_FESTIVEOVERLAY_EFFECT_FIREWORKS</option>
                </field>
                <field name="season_start" type="text" default="12-01" filter="string" maxlength="5"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_START_LABEL" description="PLG_SYSTEM_FESTIVEOVERLAY_DATES_DESC" />
                <field name="season_end" type="text" default="12-30" filter="string" maxlength="5"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_END_LABEL" description="PLG_SYSTEM_FESTIVEOVERLAY_DATES_DESC" />
                <field name="fireworks_start" type="text" default="01-01" filter="string" maxlength="5"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_FIREWORKS_START_LABEL"
                    description="PLG_SYSTEM_FESTIVEOVERLAY_FIREWORKS_START_DESC" />
                <field name="fireworks_hours" type="number" default="24" min="1" max="24" step="1" filter="integer"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_FIREWORKS_HOURS_LABEL"
                    description="PLG_SYSTEM_FESTIVEOVERLAY_FIREWORKS_HOURS_DESC" />
                <field name="sleigh" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_SLEIGH_LABEL">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="drone" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_DRONE_LABEL">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="sound" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
                    label="PLG_SYSTEM_FESTIVEOVERLAY_SOUND_LABEL" description="PLG_SYSTEM_FESTIVEOVERLAY_SOUND_DESC">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="palette" type="list" default="auto" filter="cmd" label="PLG_SYSTEM_FESTIVEOVERLAY_PALETTE_LABEL">
                    <option value="auto">PLG_SYSTEM_FESTIVEOVERLAY_PALETTE_AUTO</option>
                    <option value="light">PLG_SYSTEM_FESTIVEOVERLAY_PALETTE_LIGHT</option>
                    <option value="dark">PLG_SYSTEM_FESTIVEOVERLAY_PALETTE_DARK</option>
                </field>
                <field name="position" type="list" default="above-walks" filter="cmd" label="PLG_SYSTEM_FESTIVEOVERLAY_POSITION_LABEL"
                    description="PLG_SYSTEM_FESTIVEOVERLAY_POSITION_DESC">
                    <option value="above-walks">PLG_SYSTEM_FESTIVEOVERLAY_POSITION_WALKS</option>
                    <option value="bottom-right">PLG_SYSTEM_FESTIVEOVERLAY_POSITION_RIGHT</option>
                    <option value="bottom-left">PLG_SYSTEM_FESTIVEOVERLAY_POSITION_LEFT</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
